rule run_hals_prior_TFA_inference:
    input:
        r=expand("{datadir}/{{dataset}}/all_regulators.txt", datadir=config["datadir"]),
        d=expand("{datadir}/{{dataset}}/normalized_{{c}}_exp.txt", datadir=config["datadir"]),
        g=expand("{datadir}/{{dataset}}/all_genes.txt", datadir=config["datadir"]),
        p=expand("{datadir}/{{dataset}}/pbmc10k_prior.txt", datadir=config["datadir"]),
    output:
        out_A=expand("{outdir}/HALS-p/{{dataset}}/{{c}}/rep_0/A.txt", outdir=config["outdir"]),
        out_P=expand("{outdir}/HALS-p/{{dataset}}/{{c}}/rep_0/P.txt", outdir=config["outdir"]),
        out_rel=expand("{outdir}/HALS-p/{{dataset}}/{{c}}/rep_0/relative_error.txt", outdir=config["outdir"]),
        outdir=directory(expand("{outdir}/HALS-p/{{dataset}}/{{c}}", outdir=config["outdir"]))
    params:
        exe="/mnt/dv/wid/projects7/Roy-singlecell2/yuda_work/estimate_tfa/IBPG/tetraNMF",
        num_rep=num_random_init
    threads: 10
    benchmark: 
        "benchmarks/HALS-p/{dataset}/{c}.benchmark.txt"
    shell:
        """
        {params.exe} -d {input.d} -r {input.r} -g {input.g} -p {input.p} -o {output.outdir} \
        --max_iter {config[algo][hals_prior][max_iter]} --init_m {config[algo][hals_prior][init_m]} \
        --num_rep {params.num_rep} -t hals_prior -l {config[algo][hals_prior][l]}
        """

rule run_ibpg_TFA_inference:
    input:
        r=expand("{datadir}/{{dataset}}/all_regulators.txt", datadir=config["datadir"]),
        d=expand("{datadir}/{{dataset}}/normalized_{{c}}_exp.txt", datadir=config["datadir"]),
        g=expand("{datadir}/{{dataset}}/all_genes.txt", datadir=config["datadir"]),
        p=expand("{datadir}/{{dataset}}/pbmc10k_prior.txt", datadir=config["datadir"]),
    output:
        out_A=expand("{outdir}/ibpg/{{dataset}}/{{c}}/rep_0/A.txt", outdir=config["outdir"]),
        out_P=expand("{outdir}/ibpg/{{dataset}}/{{c}}/rep_0/P.txt", outdir=config["outdir"]),
        out_rel=expand("{outdir}/ibpg/{{dataset}}/{{c}}/rep_0/relative_error.txt", outdir=config["outdir"]),
        outdir=directory(expand("{outdir}/ibpg/{{dataset}}/{{c}}", outdir=config["outdir"]))
    params:
        exe="/mnt/dv/wid/projects7/Roy-singlecell2/yuda_work/estimate_tfa/IBPG/tetraNMF",
        num_rep=num_random_init
    threads: 10
    benchmark: 
        "benchmarks/ibpg/{dataset}/{c}.benchmark.txt"
    shell:
        """
        {params.exe} -d {input.d} -r {input.r} -g {input.g} -p {input.p} -o {output.outdir} \
        --max_iter {config[algo][ibpg][max_iter]} --init_m {config[algo][ibpg][init_m]} \
        --num_rep {params.num_rep} -t ibpg -l {config[algo][ibpg][l]} \
        --k_1 {config[algo][ibpg][k_1]} --k_2 {config[algo][ibpg][k_2]} \
        --l_reg_graph {config[algo][ibpg][l_reg_graph]} --l_tgt_graph {config[algo][ibpg][l_tgt_graph]}
        """

# ######
# ## Step 2: stability selection. Note that this is not the same as subsampling then taking the mean: it just addresses NMF's instability over different initializations
# ######
rule stability_selection_get_mean:
    input:
        rel=expand("{outdir}/{{algo}}/{{dataset}}/{{c}}/rep_0/relative_error.txt", outdir=config["outdir"]),
        in_A=expand("{outdir}/{{algo}}/{{dataset}}/{{c}}/rep_0/A.txt", outdir=config["outdir"]),
        in_P=expand("{outdir}/{{algo}}/{{dataset}}/{{c}}/rep_0/P.txt", outdir=config["outdir"])
    output:
        out_A=expand("{outdir}/{{algo}}/{{dataset}}/{{c}}_stability/A.txt", outdir=config["outdir"]),
        out_P=expand("{outdir}/{{algo}}/{{dataset}}/{{c}}_stability/P.txt", outdir=config["outdir"])
    params:
        indir_suffix="{algo}/{dataset}/{c}",
        output_precision = 7,
        file_pattern_A = "rep_*/A.txt",
        file_pattern_P = "rep_*/P.txt",
        frac_ignored= 0.2
    shell:
        """
        python {config[scriptdir]}/get_stability_selection_mean.py --A_file_pattern '{config[outdir]}/{params.indir_suffix}/{params.file_pattern_A}' \
        --P_file_pattern '{config[outdir]}/{params.indir_suffix}/{params.file_pattern_P}' --frac_ignored {params.frac_ignored} \
        --output_precision {params.output_precision} --out_A {output.out_A} --out_P {output.out_P}
        """