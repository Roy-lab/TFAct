rule create_subsamples:
    input:
        d=expand("{datadir}/{{dataset}}/inputdata/{{c}}.table", datadir=config["datadir"]),
    output:
        expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/dataset.{subsamp}.txt", \
            datadir=config["datadir"], subsamp=[str(_) for _ in range(num_subsamples)]),
    params:
        outdir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}", datadir=config["datadir"]),
        num_partitions=num_subsamples,
        frac=sub_fraction
    shell:
        """
        awk 'NR==1 {{
            for (i=1; i<=NF-1; i++) {{
                printf "\\tC%d", i-1
                if (i==NF-1) printf "\\n"
            }}
        }} 1' {input.d} > {input.d}.tmp
        total_cols=$(head -n1 {input.d} | awk -F'\\t' '{{print NF}}')
        num_to_select=$(echo "$((${{total_cols}} - 1)) * {params.frac} / 1" | bc)  
        for i in $(seq 0 $(({params.num_partitions}-1)) ); do
            selected_cols=$(seq 2 "$total_cols" | shuf | head -n "$num_to_select")
            columns="1,$(echo "$selected_cols" | paste -sd, -)"
            cut -f"$columns" {input.d}.tmp > {params.outdir}/dataset.${{i}}.txt
        done
        rm {input.d}.tmp
        """

rule create_inferelator_prior:
    input:
        p=expand("{datadir}/{{dataset}}/inputdata/{{c}}_network.txt", datadir=config["datadir"]),
        r=expand("{datadir}/{{dataset}}/inputdata/{{c}}_allregulators.txt", datadir=config["datadir"]),
        g=expand("{datadir}/{{dataset}}/inputdata/{{c}}_allGenes.txt", datadir=config["datadir"]),
    output:
        p=expand("{datadir}/{{dataset}}/inputdata/inferelator.{{c}}_network.tsv.gz", datadir=config["datadir"]),
    shell:
        """
        python {config[scriptdir]}/downstream_network_inference/create_inferelator_prior.py \
            --gene {input.g} \
            --tf_lst {input.r} \
            --prior_A {input.p} \
            --out {output.p}
        """

rule ct_create_subsample_tfa:
    input:
        exp=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/dataset.{subsamp}.txt", \
            datadir=config["datadir"], subsamp=str(num_subsamples-1)),
        tf_lst=expand("{datadir}/{{dataset}}/inputdata/allregulators.txt", \
            datadir=config["datadir"], subsamp=str(num_subsamples-1)),
        tfa=expand("{TFAdir}/{{algo}}/{{dataset}}/{{c}}_stability/P.txt", \
            TFAdir=config["TFAdir"]),
    output:
        expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/{{algo}}/{subsamp}.tsv.gz", \
            datadir=config["datadir"], subsamp=[str(_) for _ in range(num_subsamples)]),
    params:
        indir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}", datadir=config["datadir"]),
        outdir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/{{algo}}", datadir=config["datadir"]),
        num_partitions=num_subsamples,
    wildcard_constraints:
        algo="|".join(ct_algos)
    shell:
        """
        for i in $(seq 0 $(({params.num_partitions}-1)) ); do
            python {config[scriptdir]}/downstream_network_inference/reformat_tfa_to_inferelator.py \
                --exp {params.indir}/dataset.${{i}}.txt \
                --tf_lst {input.tf_lst} \
                --algo_name TFAct \
                --tfa {input.tfa} \
                --out_tfa {params.outdir}/${{i}}.tsv.gz
        done
        """

# two ways:
# 1. the list of regulator is just those having TFA values (not filtered by regularized nca)
# 2. the list of regulator is allregulators.txt, but those without TFA values have gene expression as the "TFA" values
rule regularized_nca_create_subsample_tfa:
    input:
        exp=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/dataset.{subsamp}.txt", \
            datadir=config["datadir"], subsamp=str(num_subsamples-1)),
        tf_lst=expand("{datadir}/{{dataset}}/inputdata/{{c}}_allregulators.txt", \
            datadir=config["datadir"], subsamp=str(num_subsamples-1)),
        tfa=expand("{TFAdir}/regularized_nca/{{dataset}}/{{c}}_stability/P.txt", \
            TFAdir=config["TFAdir"]),
    output:
        tfa_only=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_only/{subsamp}.tsv.gz", \
            datadir=config["datadir"], subsamp=[str(_) for _ in range(num_subsamples)]),
        tfa_and_exp=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_and_exp/{subsamp}.tsv.gz", \
            datadir=config["datadir"], subsamp=[str(_) for _ in range(num_subsamples)]),
    log:
        "logs/regularized_nca_create_subsample_tfa/{dataset}.{c}.txt"
    params:
        indir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}", datadir=config["datadir"]),
        tfa_only_outdir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_only", datadir=config["datadir"]),
        tfa_and_exp_outdir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_and_exp", datadir=config["datadir"]),
        num_partitions=num_subsamples,
        sep="\\t"
    threads: 10
    shell:
        """
        (mkdir -p {params.tfa_only_outdir}
        mkdir -p {params.tfa_and_exp_outdir}
        for i in $(seq 0 $(({params.num_partitions}-1)) ); do
            python {config[scriptdir]}/downstream_network_inference/reformat_tfa_to_inferelator.py \
                --exp {params.indir}/dataset.${{i}}.txt \
                --algo_name regularized_nca \
                --tfa {input.tfa} \
                --out_tfa {params.tfa_only_outdir}/${{i}}.tsv.gz \
                --sep $'{params.sep}'
            python {config[scriptdir]}/downstream_network_inference/reformat_tfa_to_inferelator.py \
                --exp {params.indir}/dataset.${{i}}.txt \
                --tf_lst {input.tf_lst} \
                --algo_name regularized_nca \
                --tfa {input.tfa} \
                --out_tfa {params.tfa_and_exp_outdir}/${{i}}.tsv.gz \
                --sep $'{params.sep}' \
                --replace_missing_TFA_w_exp
        done ) 2> {log}
        """

rule regularized_nca_make_regulators:
    input:
        tfa_only=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_only/0.tsv.gz", \
            datadir=config["datadir"]),
        tfa_and_exp=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_and_exp/0.tsv.gz", \
            datadir=config["datadir"]),
    output:
        tfa_only_reg=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_only/regulators.txt", \
            datadir=config["datadir"]),
        tfa_and_exp_reg=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_and_exp/regulators.txt", \
            datadir=config["datadir"]),
    params:
        tfa_only_outdir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_only", datadir=config["datadir"]),
        tfa_and_exp_outdir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/regularized_nca_tfa_and_exp", datadir=config["datadir"]),
    shell:
        """
        set +o pipefail
        zcat {params.tfa_only_outdir}/0.tsv.gz | head -n 1 | sed 's/\\t/\\n/g' | tail -n +2 > {output.tfa_only_reg}
        zcat {params.tfa_and_exp_outdir}/0.tsv.gz | head -n 1 | sed 's/\\t/\\n/g' | tail -n +2 > {output.tfa_and_exp_reg} 
        set -o pipefail
        """

algo_sep={'TIGER': "\\t", 'NINCA_quad': " ", 'supirfactor_shallow': "\\t", 'supirfactor_hierarchical': "\\t", 'NetREX_CF': "\\t"}

rule other_algo_create_subsample_tfa:
    input:
        exp=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/dataset.{subsamp}.txt", \
            datadir=config["datadir"], subsamp=str(num_subsamples-1)),
        tf_lst=expand("{datadir}/{{dataset}}/inputdata/{{c}}_allregulators.txt", \
            datadir=config["datadir"], subsamp=str(num_subsamples-1)),
        tfa=expand("{TFAdir}/{{algo}}/{{dataset}}/{{c}}/P.txt", \
            TFAdir=config["TFAdir"]),
    output:
        expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/{{algo}}/{subsamp}.tsv.gz", \
            datadir=config["datadir"], subsamp=[str(_) for _ in range(num_subsamples)]),
    params:
        indir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}", datadir=config["datadir"]),
        outdir=expand("{datadir}/{{dataset}}/inputdata/subsamples/{{c}}/TFA/{{algo}}", datadir=config["datadir"]),
        num_partitions=num_subsamples,
        sep=lambda wildcards: algo_sep[wildcards.algo]
    shell:
        """
        for i in $(seq 0 $(({params.num_partitions}-1)) ); do
            python {config[scriptdir]}/downstream_network_inference/reformat_tfa_to_inferelator.py \
                --exp {params.indir}/dataset.${{i}}.txt \
                --tf_lst {input.tf_lst} \
                --algo_name {wildcards.algo} \
                --tfa {input.tfa} \
                --out_tfa {params.outdir}/${{i}}.tsv.gz \
                --sep $'{params.sep}'
        done
        """



