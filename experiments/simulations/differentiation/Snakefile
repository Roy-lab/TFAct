        # 2 factor ibpg, cell type specific
        # expand("{outdir}/ibpg_2fct/{edgeprob}/{ldak}/all_cell_results/{TFAsimrep}/{exp}/rep_0/{pre}/A.txt", outdir=config["outdir"], \
        # edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),

        # ibpg + graph regularization + prior on ||Penalty \circ UV^T||_1
        expand("{outdir}/ibpg/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/rep_0/A.txt", outdir=config["outdir"], \
        edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),

        # ibpg + prior on ||Penalty \circ UV^T||_1
        expand("{outdir}/ibpg_wogr/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/rep_0/A.txt", outdir=config["outdir"], \
        edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),

        # ibpg without regularization
        expand("{outdir}/ibpg_noreg/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/rep_0/A.txt", outdir=config["outdir"], \
        edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),

        # nmqf + prior on ||Penalty \circ UV^T||_1
        expand("{outdir}/nmqf_hals/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/rep_0/A.txt", outdir=config["outdir"], \
        edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),

        # nmqf without regularization
        expand("{outdir}/nmqf_hals_noreg/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/rep_0/A.txt", outdir=config["outdir"], \
        edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),

        ### existing algorithms, start
        # 1. pmf_grn
        # here obtain the best hyperparamters
        expand("{outdir}/pmf_grn/experiments/hpsearch/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/{fold_num}/hyperparams_used.txt", \
            outdir=config["outdir"],edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout, \
