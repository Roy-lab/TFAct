        edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout, algo=stability_algos),
        
        ####
        # Part 2: Analysis
        ####
        expand("{outdir}/{algo}/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/stats_{top_e}/tf_specifics.txt", outdir=config["outdir"], \
