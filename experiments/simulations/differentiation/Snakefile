rule collect_F_scores:
    input:
        expand("{outdir}/{algo}/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/stats_{top_e}/stat.txt", outdir=config["outdir"], \
        algo=algos, edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout, top_e=top_edges)
    output:
        expand("{outdir}/analysis/Fscores.txt", outdir=config["outdir"])
    params:
        stat_path=[config["outdir"]+ '/'+alg + '/*/*/*/*/*/stats_*/stat.txt' for alg in algos]
    shell: # note: modify below to include more algorithms
        """
        awk 'BEGIN{{OFS="\\t"}}NR==1{{$1=$1; printf "file_name\\t%s\\n", $0}}FNR==2{{printf "%s\\t",  FILENAME}} FNR>1{{print}}' {params.stat_path} | \
        awk -F'\\t' -v regex_pattern='{config[outdir]}/([^/]+|baselines/[^/]+)/(0.[0-9]+)/(k[0-9]+)/([^/]+)/(rep[0-9]+)/([^/]+)_stability/stats_([0-9]+)'  'BEGIN{{OFS="\\t"}} NR==1{{printf "algo\\tedge_addition_prob\\tlda_topics\\tcell\\tTFA_rep\\texp_dropout\\tFscore_top_edge\\t"; 
            for (i=2; i<NF; i++) printf $i "\\t"; print $NF }}NR>1{{
            $1=$1; 
            match($1, regex_pattern, arr);
            printf "%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t", arr[1], arr[2], arr[3], arr[4], arr[5], arr[6], arr[7];
            for (i=2; i<NF; i++) printf $i "\\t"; print $NF 
        }}' > {output}
        """


rule stability_get_clustering_accurarcy:
    input: 
        P=expand("{outdir}/{{algo}}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/{{exp}}_stability/P.txt", outdir=config["outdir"]),
        gt_celltype=expand("{datadir}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/cell_celltype_assignments.txt", datadir=config["datadir"]),
    output:
        outstat=expand("{outdir}/{{algo}}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/{{exp}}_stability/downstream_analysis/clust_stats.txt", outdir=config["outdir"])
    wildcard_constraints:
        algo="|".join(algos)
    conda:
        "/mnt/dv/wid/projects7/Roy-singlecell2/yuda_work/.conda/envs/Seurat"
    shell:
        """
        if [[ "regularized_nca" =~ {wildcards.algo} ]]; then
            Rscript {config[scriptdir]}/downstream_analysis/Seurat_clustering.R \
            {input.P} \
            {input.gt_celltype} \
            {config[tflist]} \
            $'\\t' \
            T \
            {output.outstat}
        else
            Rscript {config[scriptdir]}/downstream_analysis/Seurat_clustering.R \
            {input.P} \
            {input.gt_celltype} \
            {config[tflist]} \
            ' ' \
            F \
            {output.outstat}
        fi
        """

rule collect_clust_accurarcy:
    input:
        expand("{outdir}/{algo}/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/downstream_analysis/clust_stats.txt", outdir=config["outdir"], \
        algo=algos, edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout, top_e=top_edges)
    output:
        expand("{outdir}/analysis/clustering_stats.txt", outdir=config["outdir"])
    params:
        stat_path=[config["outdir"]+ '/'+alg + '/*/*/*/*/*/downstream_analysis/clust_stats.txt' for alg in algos]
    shell: # note: modify below to include more algorithms
        """
        awk 'BEGIN{{OFS="\\t"}}NR==1{{$1=$1; printf "file_name\\t%s\\n", $0}}FNR==2{{printf "%s\\t",  FILENAME}} FNR>1{{print}}' {params.stat_path} | \
        awk -F'\\t' -v regex_pattern='{config[outdir]}/([^/]+|baselines/[^/]+)/(0.[0-9]+)/(k[0-9]+)/([^/]+)/(rep[0-9]+)/([^/]+)_stability/downstream_analysis'  'BEGIN{{OFS="\\t"}} NR==1{{printf "algo\\tedge_addition_prob\\tlda_topics\\tcell\\tTFA_rep\\texp_dropout\\t"; 
            for (i=2; i<NF; i++) printf $i "\\t"; print $NF }}NR>1{{
            $1=$1; 
            match($1, regex_pattern, arr);
            printf "%s\\t%s\\t%s\\t%s\\t%s\\t%s\\t", arr[1], arr[2], arr[3], arr[4], arr[5], arr[6];
            for (i=2; i<NF; i++) printf $i "\\t"; print $NF 
        }}' > {output}
        """