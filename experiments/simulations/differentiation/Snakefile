        # full prior run
        expand("{outdir}/pmf_grn/experiments/full_prior/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/best_iter.params", outdir=config["outdir"],\
            edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),
        
        # consensus
        expand("{outdir}/pmf_grn/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/inferred_consensus_tfa.tsv", outdir=config["outdir"],\
            edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),
        
        # 2. FastNCA
        expand("{outdir}/FastNCA/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/A.txt", outdir=config["outdir"], \
            edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),
        
        # 3. NINCA_lp, NINCA_quad
        expand("{outdir}/NINCA_quad/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/A.txt", outdir=config["outdir"],\
