        # expand("{outdir}/{algo}/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/stats_{top_e}/tf_specifics.txt", outdir=config["outdir"], \
        # edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout, top_e=top_edges, algo=gene_by_tf_A_algos),
        # expand("{outdir}/{algo}/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/stats_{top_e}/tf_specifics.txt", outdir=config["outdir"], \
