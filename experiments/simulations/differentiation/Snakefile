        # testing cell type specific algos' sensitivity to hyperparameters
        ###
        expand("{outdir}/analysis/ct/clustering_stats.txt", outdir=config["outdir"]),
        expand("{outdir}/analysis/ct/Fscores.txt", outdir=config["outdir"]),

        # checking if the performance deteriorates with increasing l1 regularization and l_tree after a certain threshold. We do it for only one sparsity level (0.4, denser) and one lda_k (k20, lower noise level) and two dropout levels for now.
        expand("{outdir}/ct_algos/{algo}/{l1}_{l_tree}/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/stats_{top_e}/tf_specifics.txt", outdir=config["outdir"], \
