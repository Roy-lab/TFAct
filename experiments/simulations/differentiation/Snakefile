rule all:
    input:
        ####
        # Part 1: Running algorithms
        ####
        # regularized nca
        expand("{outdir}/regularized_nca/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/{stability_rep}/adj.txt", outdir=config["outdir"], \
            edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout, stability_rep = ["rep_"+str(_) for _ in range(num_random_init)]),
        expand("{outdir}/regularized_nca/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/adj_filelist.txt", outdir=config["outdir"], \
            edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),
        expand("{outdir}/regularized_nca/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/P.txt", outdir=config["outdir"], \
            edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout),

        # 2 factor hals with prior
        expand("{outdir}/baselines/hals_prior/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}/rep_0/A.txt", outdir=config["outdir"], \
