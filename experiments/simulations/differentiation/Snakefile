## cell type specific algos
ct_algos = ['ibpg_2fct', 'kl_nmf_2fct']

# algos need to be specified to calculate Fscores
algos=['baselines/hals_prior', 'ibpg', 'ibpg_wogr', 'ibpg_noreg', 'nmqf_hals', 'nmqf_hals_noreg', 'FastNCA', 'NINCA_quad', 'pmf_grn', 'regularized_nca', 'BITFAM', 'TIGER', 'NetREX_CF', 'supirfactor_shallow', 'supirfactor_hierarchical', 'ibpg_2f', 'ibpg_2fct', 'kl_nmf_2fct']
# algos=['baselines/hals_prior', 'ibpg', 'ibpg_wogr', 'ibpg_noreg', 'nmqf_hals', 'nmqf_hals_noreg', 'FastNCA', 'NINCA_quad', 'pmf_grn', 'regularized_nca', 'BITFAM', 'TIGER', 'NetREX_CF', 'supirfactor_shallow', 'supirfactor_hierarchical', 'ibpg_2f']
stability_algos=['ibpg_2f', 'ibpg_2fct', 'kl_nmf_2fct', 'baselines/hals_prior', 'ibpg', 'ibpg_wogr', 'ibpg_noreg', 'nmqf_hals', 'nmqf_hals_noreg'] # a subset
# stability_algos=['ibpg_2f', 'baselines/hals_prior', 'ibpg', 'ibpg_wogr', 'ibpg_noreg', 'nmqf_hals', 'nmqf_hals_noreg'] # a subset

# the below may add up to stability_algos
gene_by_tf_A_algos=['ibpg_2f', 'ibpg_2fct', 'kl_nmf_2fct', 'ibpg', 'ibpg_wogr', 'ibpg_noreg', 'nmqf_hals', 'nmqf_hals_noreg', 'FastNCA', 'NINCA_quad', 'pmf_grn'] # algorithms that infer a gene-by-tf GRN matrix
# gene_by_tf_A_algos=['ibpg_2f', 'ibpg', 'ibpg_wogr', 'ibpg_noreg', 'nmqf_hals', 'nmqf_hals_noreg', 'FastNCA', 'NINCA_quad', 'pmf_grn'] # algorithms that infer a gene-by-tf GRN matrix
tf_by_gene_A_algos=['baselines/hals_prior'] # algorithms that infer a tf-by-gene GRN matrix
edge_lst_A_algos=['regularized_nca'] # return a 3 column edge file

##
# Hyperparameters for cell type-specific nmf
##
lambda_p = 0.1
lambda_Cminus = 0.1
l1_choices = [0, 10, 100, 1000]
lineage_reg_choices = [0, 10, 100, 1000]
expanded_l1_choices = [0, 10, 100, 1000, 10000, 100000, 1000000, 10000000] # see if l1 gets saturated eventually.
expanded_lineage_reg_choices = [0, 10, 100, 1000, 10000, 100000, 1000000, 10000000] # see if l1 gets saturated eventually.

include: "rules/pmf_grn.smk" # included here such that variables defined above will be accessible
