        # Fscores
        expand("{outdir}/analysis/Fscores.txt", outdir=config["outdir"] ),
        
        # clustering accurarcy and related stats
        expand("{outdir}/{algo}/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/downstream_analysis/clust_stats.txt", outdir=config["outdir"], \
        edgeprob=edge_adding_prob,ldak=lda_k,pre=prefixes,TFAsimrep=TFA_sim_rep, exp=exp_mat_w_dropout, top_e=top_edges, algo=stability_algos),
        expand("{outdir}/analysis/clustering_stats.txt", outdir=config["outdir"]),
        
        # # AUPR and regulator specific AUPR
        expand("{outdir}/{algo}/{edgeprob}/{ldak}/{pre}/{TFAsimrep}/{exp}_stability/AUPR/AUPR_TF.txt", outdir=config["outdir"], \
