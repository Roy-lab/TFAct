rule algo_get_summary_stat:
    input:
        A=expand("{outdir}/{{algo}}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/{{exp}}_stability/A.txt", outdir=config["outdir"]),
        P=expand("{outdir}/{{algo}}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/{{exp}}_stability/P.txt", outdir=config["outdir"]),
        prior=expand("{datadir}/{{edgeprob}}/{{ldak}}/{{pre}}_prior.txt", datadir=config["datadir"]),
        true_P=expand("{datadir}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/P.txt", datadir=config["datadir"]),
        g=expand("{genedir}/{{edgeprob}}/{{pre}}/genes.txt", genedir=config['genedir']),
    output:
        expand("{outdir}/{{algo}}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/{{exp}}_stability/stats_{{top_e}}/tf_specifics.txt", outdir=config["outdir"]),
        expand("{outdir}/{{algo}}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/{{exp}}_stability/stats_{{top_e}}/stat.txt", outdir=config["outdir"])
    wildcard_constraints:
        algo="|".join(algos) 
    conda:
        "/mnt/dv/wid/projects7/Roy-singlecell2/yuda_work/.conda/envs/scanpy" # change this
    params:
        outdir=expand("{outdir}/{{algo}}/{{edgeprob}}/{{ldak}}/{{pre}}/{{TFAsimrep}}/{{exp}}_stability/stats_{{top_e}}", outdir=config["outdir"]),
        tf_by_gene=lambda wildcards: ' '.join(f"'{_}'" for _ in tf_by_gene_A_algos),
        gene_by_tf=lambda wildcards: ' '.join(f"'{_}'" for _ in gene_by_tf_A_algos)
    shell:
        """
        tf_by_gene=( {params.tf_by_gene} )
        gene_by_tf=( {params.gene_by_tf} )
        if [[ " ${{gene_by_tf[*]}} " =~ [[:space:]]{wildcards.algo}[[:space:]] ]]; then
            python {config[scriptdir]}/compare_networks_and_TFA.py \
            --outdir {params.outdir} \
            --inferred_A {input.A}  \
            --inferred_P {input.P} \
            --true_A {config[genedir]}/{wildcards.edgeprob}/{wildcards.pre}/nw.tsv \
            --prior_A {input.prior} \
            --true_P {input.true_P} \
            --tf_lst {config[tflist]} \
            --gene {input.g} \
            --top {wildcards.top_e} \
            --transpose_inferred_A
        elif [[ " ${{tf_by_gene[*]}} " =~ [[:space:]]{wildcards.algo}[[:space:]] ]]; then
            python {config[scriptdir]}/compare_networks_and_TFA.py \
            --outdir {params.outdir} \
            --inferred_A {input.A}  \
            --inferred_P {input.P} \
            --true_A {config[genedir]}/{wildcards.edgeprob}/{wildcards.pre}/nw.tsv \
            --prior_A {input.prior} \
            --true_P {input.true_P} \
            --tf_lst {config[tflist]} \
            --gene {input.g} \
            --top {wildcards.top_e}
        else # edge list
            python {config[scriptdir]}/compare_networks_and_TFA.py \
            --outdir {params.outdir} \
            --inferred_A {input.A}  \
            --inferred_P {input.P} \
            --true_A {config[genedir]}/{wildcards.edgeprob}/{wildcards.pre}/nw.tsv \
            --prior_A {input.prior} \
            --true_P {input.true_P} \
            --tf_lst {config[tflist]} \
            --gene {input.g} \
            --top {wildcards.top_e} \
            --A_edge_lst
        fi
        """

