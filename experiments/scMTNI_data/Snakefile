rule FBS_reformatting_0:
    params:
        d=expand("{datadir}/FBS_reprogramming/inputdata/{{c}}.table", datadir=config["datadir"]),
        g=expand("{datadir}/FBS_reprogramming/inputdata/{{c}}_allGenes.txt", datadir=config["datadir"]),
        p=expand("{datadir}/FBS_reprogramming/inputdata/{{c}}_network.txt", datadir=config["datadir"]),
    output:
        d=expand("{datadir}/processed_FBS_reprogramming/inputdata/{{c}}.table", datadir=config["datadir"]),
        g=expand("{datadir}/processed_FBS_reprogramming/inputdata/{{c}}_allGenes.txt", datadir=config["datadir"]),
        p=expand("{datadir}/processed_FBS_reprogramming/inputdata/{{c}}_network.txt", datadir=config["datadir"]),
        c=expand("{datadir}/processed_FBS_reprogramming/inputdata/{{c}}_cell_names.txt", datadir=config["datadir"]),
    shell:
        """
        head -n 1 {params.d} | tr '\\t' '\\n' | tail -n +2 > {output.c}
        tail -n +2 {params.d} | awk -F'\\t' -v cluster="_{wildcards.c}" -v OFS='\\t' '{{sub(cluster "$", "", $1); print}}' > {output.d}
        sed 's/_{wildcards.c}$//g' {params.g} > {output.g}
        awk -F'\\t' -v cluster="_{wildcards.c}" -v OFS='\\t' '{{sub(cluster "$", "", $1); sub(cluster "$", "", $2); print}}' {params.p} > {output.p}
        rm {params.d} {params.g} {params.p}
        """

# make regulators list
rule FBS_reformatting_1:
    input:
        p=expand("{datadir}/processed_FBS_reprogramming/inputdata/{{c}}_network.txt", datadir=config["datadir"]),
    output:
        r=expand("{datadir}/processed_FBS_reprogramming/inputdata/{{c}}_allregulators.txt", datadir=config["datadir"]),
    shell:
        """
        cut -f1 {input.p} | sort -u > {output.r}
        """

rule FBS_reformatting_2:
    input:
        r=expand("{datadir}/processed_FBS_reprogramming/inputdata/{c}_allregulators.txt", datadir=config["datadir"], c=FBS_clusters),
    output:
        r=expand("{datadir}/processed_FBS_reprogramming/inputdata/allregulators.txt", datadir=config["datadir"]),
    shell:
        """
        cat {input.r} | sort -u > {output.r}
        """


rule BH_reformatting_0:
    params:
        d=expand("{datadir}/Buenrostro_Hematopoiesis/inputdata/{{c}}.table", datadir=config["datadir"]),
        g=expand("{datadir}/Buenrostro_Hematopoiesis/inputdata/{{c}}_allGenes.txt", datadir=config["datadir"]),
        p=expand("{datadir}/Buenrostro_Hematopoiesis/inputdata/{{c}}_network.txt", datadir=config["datadir"]),
    output:
        d=expand("{datadir}/processed_Buenrostro_Hematopoiesis/inputdata/{{c}}.table", datadir=config["datadir"]),
        g=expand("{datadir}/processed_Buenrostro_Hematopoiesis/inputdata/{{c}}_allGenes.txt", datadir=config["datadir"]),
        p=expand("{datadir}/processed_Buenrostro_Hematopoiesis/inputdata/{{c}}_network.txt", datadir=config["datadir"]),
        c=expand("{datadir}/processed_Buenrostro_Hematopoiesis/inputdata/{{c}}_cell_names.txt", datadir=config["datadir"]),
    shell:
        """
        head -n 1 {params.d} | tr '\\t' '\\n' | tail -n +2 > {output.c}
        tail -n +2 {params.d} | awk -F'\\t' -v cluster="_{wildcards.c}" -v OFS='\\t' '{{sub(cluster "$", "", $1); print}}' > {output.d}
        sed 's/_{wildcards.c}$//g' {params.g} > {output.g}
        awk -F'\\t' -v cluster="_{wildcards.c}" -v OFS='\\t' '{{sub(cluster "$", "", $1); sub(cluster "$", "", $2); print}}' {params.p} > {output.p}
        rm {params.d} {params.g} {params.p}
        """

